# Backend Production Environment Variables (Render)

# Spring Profile (activates PostgreSQL mode)
SPRING_PROFILES_ACTIVE=postgres

# Server Port (Render sets this automatically; defaults to 8080 if not set)
PORT=8080

# Neon PostgreSQL Database Connection
# Option 1: Full JDBC URL (recommended for Neon)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-your-subdomain.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_password

# Option 2: Individual DB components
# DB_HOST=ep-your-subdomain.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_NAME=neondb
# DB_USER=neondb_owner
# DB_PASSWORD=your_neon_password

# Secure 256-bit Hex JWT Secret for production (generate with openssl rand -hex 32)
JWT_SECRET=your_secure_256_bit_production_jwt_secret_key_here

# Allowed CORS Origins (comma-separated, your deployed Vercel domain and local dev)
CORS_ALLOWED_ORIGINS=https://your-airwise-app.vercel.app,http://localhost:5173

# Optional: Data Sync Scheduler (defaults to true)
DATA_SYNC_ENABLED=true

